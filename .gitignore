# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client is generated into node_modules/.prisma/client by `prisma
# generate`, which runs on both install and build. Nothing generated belongs in
# git: committing the client (and its platform-specific ~20MB engine binary) is
# what shipped a Windows engine to Vercel's Linux runtime and 500'd every route
# that touches the database.
/prisma/lib/generated
